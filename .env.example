# Copy to .env for local dev.  NEVER commit your real key.

# ---- Groq (required for the AI brain) ----
GROQ_API_KEY=your_groq_api_key_here
GROQ_CHAT_MODEL=openai/gpt-oss-120b        # or openai/gpt-oss-20b (faster)
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english   # accept model terms in Groq console
GROQ_TTS_VOICE=troy                        # male; also try austin, adam

# ---- Hotel info ----
HOTEL_NAME=City Resort Hotel
RECEPTIONIST_NAME=Daven
HOTEL_LOCATION=12 Kingsway Road, Osogbo, Osun State, Nigeria
HOTEL_PHONE=+234 800 000 0000
HOTEL_EMAIL=stay@cityresorthotel.com
CHECK_IN=2:00 PM
CHECK_OUT=12:00 noon
PRICE_STANDARD=N15,000
PRICE_DELUXE=N25,000
PRICE_EXECUTIVE=N45,000
