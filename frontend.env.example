# ============================================================
# FRONTEND .env  —  point YOUR web UI at the deployed Daven API
# ============================================================
# 1. Deploy the backend (this repo) to Render. You'll get a URL like:
#       https://ai-receptionist-xxxx.onrender.com
# 2. Paste that URL below into DAVEN_API_URL.
# 3. Drop the URL back to me and I'll generate the exact file for you.
#
# Use the variable name your framework expects:
#   React (CRA)  -> REACT_APP_DAVEN_API_URL
#   Vite         -> VITE_DAVEN_API_URL
#   Next.js      -> NEXT_PUBLIC_DAVEN_API_URL
#   Plain HTML/JS-> just set `const API = "https://...";` in your script
# ============================================================

DAVEN_API_URL=https://YOUR-APP-NAME.onrender.com

# (optional) which voice Daven speaks with (edge-tts male voices)
DAVEN_VOICE=en-US-GuyNeural
# other male voices: en-US-AndrewNeural, en-GB-RyanNeural, en-NG-AbeoNeural (Nigerian)
