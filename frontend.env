# ============================================================
# FRONTEND .env  —  connect YOUR web UI to Daven (LIVE)
# Deployed API: https://a-receptionist.onrender.com
# ============================================================
# Pick the variable name YOUR framework reads and delete the others.
# React (CRA)  -> REACT_APP_DAVEN_API_URL
# Vite         -> VITE_DAVEN_API_URL
# Next.js      -> NEXT_PUBLIC_DAVEN_API_URL
# ============================================================

REACT_APP_DAVEN_API_URL=https://a-receptionist.onrender.com
VITE_DAVEN_API_URL=https://a-receptionist.onrender.com
NEXT_PUBLIC_DAVEN_API_URL=https://a-receptionist.onrender.com
DAVEN_API_URL=https://a-receptionist.onrender.com

# Optional: which male voice Daven speaks with (edge-tts)
DAVEN_VOICE=en-US-GuyNeural
# alternatives: en-US-AndrewNeural, en-GB-RyanNeural, en-NG-AbeoNeural (Nigerian)
